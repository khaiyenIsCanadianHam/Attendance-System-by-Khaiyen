# Documentation only: configure these through the shell/deployment secret store.
# This app does not automatically load .env files.
# ATTENDANCE_INSTANCE=/private/persistent/attendance
# ATTENDANCE_TRUSTED_HOSTS=attendance.example.edu
# DATABASE_URL=   (private PostgreSQL connection URL; omitted uses local SQLite)
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=  (secret, needed only for explicit email delivery)
# SMTP_PORT=465
# STUDENT_SHEET_URL=  (Viewer-accessible Google Sheets CSV export; use --google-forms for Forms responses)
# ATTENDANCE_LOCAL_HTTP=1  (only for local HTTP development)
# ATTENDANCE_SESSION_KEY= (optional secret override, at least 32 random characters)
# ATTENDANCE_QR_KEY=      (optional secret override, URL-safe base64 of 32 random bytes)
